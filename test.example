"""Open the real Edge profile, confirm X login and save session."""

from __future__ import annotations

import asyncio
import sys
from pathlib import Path

from playwright.async_api import async_playwright


PROJECT_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT_ROOT))


async def main() -> None:

    # Perfil REAL do Edge do usuário
    edge_profile = (
        Path.home()
        / "AppData"
        / "Local"
        / "Microsoft"
        / "Edge"
        / "User Data"
    )

    print("\nUsando perfil real do Edge:")
    print(edge_profile)

    async with async_playwright() as playwright:

        context = await playwright.chromium.launch_persistent_context(
            user_data_dir=str(edge_profile),
            channel="msedge",
            headless=False,
            locale="pt-BR",
            args=[
                "--profile-directory=Default",
            ],
            viewport={
                "width": 1440,
                "height": 1000,
            },
        )

        page = (
            context.pages[0]
            if context.pages
            else await context.new_page()
        )

        await page.goto(
            "https://x.com/home",
            wait_until="domcontentloaded",
            timeout=60000,
        )

        print("\nPágina do X aberta.")
        print("Confirme se a conta dele já está logada.")
        print("NÃO faça login pelo script.")

        await asyncio.to_thread(
            input,
            "\nPressione ENTER para salvar a sessão e fechar..."
        )

        await context.close()

        print("\nSessão confirmada e salva no perfil do Edge.")


if __name__ == "__main__":
    asyncio.run(main())