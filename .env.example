# Telegram — obtenha API_ID e API_HASH em https://my.telegram.org
API_ID=
API_HASH=
CHANNEL=@seu_canal

# O telefone facilita o primeiro login do Telethon. Use formato internacional.
TELEGRAM_PHONE=+55DDDNUMERO
# Opcional. Evite manter esta variável preenchida após a sessão ser criada.
TELEGRAM_2FA_PASSWORD=

# X — usado para construir URLs e, opcionalmente, no login automático.
TWITTER_USERNAME=@seu_usuario
TWITTER_PASSWORD=
TWITTER_EMAIL=

# Login manual persistente é o modo recomendado.
X_AUTO_LOGIN=false
X_HEADLESS=true
X_BASE_URL=https://x.com
X_CHAR_LIMIT=280
X_MAX_IMAGES=4
X_NAVIGATION_TIMEOUT_MS=45000
X_UPLOAD_TIMEOUT_MS=180000

# Resiliência
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=300
STARTUP_GRACE_SECONDS=0
LOG_LEVEL=INFO
STORAGE_DIR=storage
