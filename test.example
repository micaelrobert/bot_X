"""Open a headed persistent Chromium session using the real Edge profile."""

from __future__ import annotations

import asyncio
import sys
from pathlib import Path

from playwright.async_api import async_playwright


PROJECT_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT_ROOT))


async def main() -> None:

    # Perfil REAL do Edge já usado pelo usuário
    edge_profile = (
        Path.home()
        / "AppData"
        / "Local"
        / "Microsoft"
        / "Edge"
        / "User Data"
    )

    print("\nPerfil Edge utilizado:")
    print(edge_profile)

    if not edge_profile.exists():
        raise Exception(
            f"Perfil do Edge não encontrado: {edge_profile}"
        )

    async with async_playwright() as playwright:

        context = await playwright.chromium.launch_persistent_context(
            user_data_dir=str(edge_profile),
            channel="msedge",
            headless=False,
            locale="pt-BR",
            args=[
                "--profile-directory=Default",
            ],
            viewport={
                "width": 1440,
                "height": 1000,
            },
        )

        # Remove a página inicial vazia do Chromium
        for p in context.pages:
            await p.close()

        # Cria uma nova página usando a sessão salva
        page = await context.new_page()

        print("\nAbrindo X...")

        await page.goto(
            "https://x.com/home",
            wait_until="domcontentloaded",
            timeout=45000,
        )

        print("\nPágina do X aberta.")
        print("Confira se a conta está logada.")

        await asyncio.to_thread(
            input,
            "\nPressione ENTER para salvar a sessão e fechar..."
        )

        await context.close()

        print("\nSessão persistida com sucesso!")
        print(f"Perfil salvo em: {edge_profile}")


if __name__ == "__main__":
    asyncio.run(main())