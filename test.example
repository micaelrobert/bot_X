"""Open a headed persistent Chromium session for X."""

from __future__ import annotations

import asyncio
from pathlib import Path

from playwright.async_api import async_playwright


async def main():

    edge_profile = (
        Path.home()
        / "AppData"
        / "Local"
        / "Microsoft"
        / "Edge"
        / "User Data"
    )

    async with async_playwright() as p:

        print("Abrindo Edge...")

        context = await p.chromium.launch_persistent_context(
            user_data_dir=str(edge_profile),
            channel="msedge",
            headless=False,
            locale="pt-BR",
            args=[
                "--profile-directory=Default",
            ],
            viewport={
                "width": 1440,
                "height": 1000,
            },
        )

        print("Edge aberto!")

        print("Páginas detectadas:")
        for page in context.pages:
            print(page.url)

        # Cria uma nova aba controlada pelo Playwright
        page = await context.new_page()

        print("Abrindo X...")

        await page.goto(
            "https://x.com/home",
            wait_until="domcontentloaded",
            timeout=60000,
        )

        print("X carregado!")
        print("Confira se está logado.")

        await asyncio.to_thread(
            input,
            "ENTER para fechar..."
        )

        await context.close()


if __name__ == "__main__":
    asyncio.run(main())